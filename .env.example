# BullyMail V2 Environment Configuration
# Copy this file to .env and adjust the values for your environment.

# Flask Application Settings
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=change_this_to_a_cryptographically_secure_random_key_in_production
PORT=5000
HOST=0.0.0.0

# Trusted Public Base URL (Used for generating email verification and password reset links)
# For local development: http://localhost:5000
# For LAN access:        http://<LAN_IP>:5000 (e.g. http://192.168.1.100:5000)
# For production:        https://yourdomain.com
APP_BASE_URL=http://localhost:5000

# Initial Administrator Credentials (Required in production, generated randomly if omitted in dev)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_strong_admin_passphrase_min_12_chars
ADMIN_EMAIL=admin@bullymail.local

# Session Security
SESSION_COOKIE_SECURE=False  # Set True when deploying over HTTPS
SESSION_COOKIE_SAMESITE=Lax

# Database Configuration
# Supported types: 'mysql' or 'sqlite'
DB_TYPE=mysql
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_database_password_here
DB_NAME=bullymail_db
MYSQL_ROOT_PASSWORD=your_mysql_root_password_for_docker_here

# SQLite Fallback Path (Used automatically if DB_TYPE=sqlite or if MySQL connection fails)
SQLITE_DB_PATH=bullymail.db

# Model & Dataset Storage Paths
MODEL_PATH=saved_models
DATASET_PATH=datasets
UPLOAD_PATH=uploads

# Security & Upload Settings
# Master Cryptographic Key (Fernet AES-128 credential encryption)
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BULLYMAIL_MASTER_KEY=your_base64_32byte_master_encryption_key_here

# Worker Daemon & Polling
WORKER_POLL_INTERVAL=15

# Optional: AI / LLM Threat Reasoning (Experimental Feature)
OPENROUTER_API_KEY=your_openrouter_api_key_here
